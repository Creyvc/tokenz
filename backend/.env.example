# Get the actual endpoint and model from your Alibaba Cloud account.
QWEN_API_KEY=
QWEN_BASE_URL=https://<workspace-id>.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-flash
# Blank temperature omits it for models that do not support this parameter.
QWEN_TEMPERATURE=0.2
QWEN_MAX_OUTPUT_TOKENS=256
QWEN_MAX_ATTEMPTS=2
QWEN_REQUEST_TIMEOUT_SECONDS=20
QWEN_TOTAL_BUDGET_SECONDS=40
QWEN_MAX_INPUT_TOKENS=6000
# Enable only if the chosen model documentation supports this setting.
QWEN_ENABLE_THINKING=
# USD per million provider tokens; blank means unknown.
QWEN_INPUT_USD_PER_1M=
QWEN_OUTPUT_USD_PER_1M=
TARGET_TOKEN_ENCODING=o200k_base
