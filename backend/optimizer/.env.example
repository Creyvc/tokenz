# API secrets stay here, never in source control. Demo mode needs no keys.
TOKENZ_DEMO=true
TOKENZ_FREE_ONLY=true
TOKENZ_TARGET_PROVIDER=openrouter_target
OPENROUTER_API_KEY=
OPENROUTER_OPTIMIZER_MODEL=cohere/north-mini-code:free
OPENROUTER_TARGET_MODEL=nvidia/nemotron-3.5-lightning:free
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
QWEN_API_KEY=
# Copy your workspace-specific, region-matched compatible-mode/v1 URL from Model Studio.
QWEN_BASE_URL=
QWEN_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Provider-specific controls. Blank leaves the provider default unchanged.
QWEN_ENABLE_THINKING=false
OPENAI_REASONING_EFFORT=
TOKENZ_OPTIMIZER_PROVIDER=openrouter_optimizer
TOKENZ_DEFAULT_STRATEGY=structured
# Initial research settings, not experimentally established thresholds.
TOKENZ_SKIP_OPTIMIZATION_BELOW=100
TOKENZ_MIN_QUALITY_RETENTION=0.95
TOKENZ_TARGET_RATIO=0.75
TOKENZ_MAX_OUTPUT_TOKENS=2048
TOKENZ_OPTIMIZER_MAX_OUTPUT_TOKENS=4096
# Blank omits temperature, for models that do not support it.
TOKENZ_TARGET_TEMPERATURE=
TOKENZ_OPTIMIZER_TEMPERATURE=0
TOKENZ_TIMEOUT_SECONDS=60
TOKENZ_BATCH_DELAY_SECONDS=10
TOKENZ_MAX_EXPERIMENT_COST_USD=5
TOKENZ_STORE_DATA=true
TOKENZ_DATABASE=results/free-experiments.sqlite3
TOKENZ_TOKENIZER_ENCODING=o200k_base
# USD per million tokens. Blank means unknown, NEVER free.
OPENAI_INPUT_PRICE_PER_MILLION=
OPENAI_OUTPUT_PRICE_PER_MILLION=
QWEN_INPUT_PRICE_PER_MILLION=
QWEN_OUTPUT_PRICE_PER_MILLION=
DEEPSEEK_INPUT_PRICE_PER_MILLION=
DEEPSEEK_OUTPUT_PRICE_PER_MILLION=

# Methodology 1 integration. OpenAI dispatch remains BLOCKED in this free-only build.
OPENAI_TARGET_MODEL=gpt-5.5
GROQ_API_KEY=
GROQ_QWEN_MODEL=qwen/qwen3.8-27b
GROQ_GPT_OSS_20B_MODEL=openai/gpt-oss-20b
GROQ_GPT_OSS_120B_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
# GOOGLE_API_KEY is accepted as an alias when GEMINI_API_KEY is blank.
# gemini-3.6-flash is the version that answered in live testing (3.8 gave service errors, docs/STATUS.md).
GEMINI_MODEL=gemini-3.6-flash
OPENROUTER_MODEL=openrouter/free
TOKENZ_DEFAULT_OPTIMIZER=qwen
TOKENZ_TEMPERATURE=0.1
TOKENZ_REQUEST_TIMEOUT_SECONDS=60
TOKENZ_MIN_PROMPT_TOKENS=100
TOKENZ_ENABLE_GEMINI=true
TOKENZ_ENABLE_OPENROUTER=true
# Leave false unless YOU have confirmed a free provider account with billing disabled.
# These are user declarations, not server-verified billing status.
TOKENZ_GROQ_FREE_TIER_CONFIRMED=false
TOKENZ_GEMINI_FREE_TIER_CONFIRMED=false
